# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real credentials.

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Optional overrides:
# CLAUDE_MODEL=claude-sonnet-5
# CLAUDE_MAX_TOKENS=16000

# --- Cloudflare ---
CF_API_TOKEN=your-cloudflare-api-token
CF_ZONE_ID=your-cloudflare-zone-id

# --- Hostinger ---
HOSTINGER_API_TOKEN=your-hostinger-api-token
HOSTINGER_USERNAME=your-hostinger-username
# Bare domain, no scheme — used as a path segment, not a request URL.
HOSTINGER_DOMAIN=example.com

# --- WordPress / WooCommerce ---
# Full URL including https:// (the script will add it if you forget,
# but it's clearer to write it out here).
WP_BASE_URL=https://example.com
WP_USER=your-wordpress-username
# Generate this under wp-admin -> Users -> Profile -> Application Passwords.
# It is NOT your normal login password.
WP_APP_PASS=xxxx xxxx xxxx xxxx xxxx xxxx
